<!-- Custom Scroll Particle Canvas -->
<canvas id="scroll-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 99999;"></canvas>

<script>
(function() {
    const canvas = document.getElementById('scroll-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let lastScrollY = window.scrollY;
    let accumulatedScroll = 0;
    const SCROLL_THRESHOLD = 35; 

    window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    class Particle {
        constructor(x, y) {
            this.x = x + (Math.random() - 0.5) * 20;
            this.y = y + (Math.random() - 0.5) * 20;
            this.size = Math.random() * 8 + 12; 
            this.type = Math.floor(Math.random() * 4); 
            this.opacity = 1;
            this.speedY = -(Math.random() * 0.8 + 0.4);
            this.speedX = (Math.random() - 0.5) * 0.6;
            this.rotation = Math.random() * Math.PI * 2;
            this.rotSpeed = (Math.random() - 0.5) * 0.03;
            this.fadeRate = Math.random() * 0.012 + 0.008;
        }

        update() {
            this.y += this.speedY;
            this.x += this.speedX;
            this.rotation += this.rotSpeed;
            this.opacity -= this.fadeRate;
        }

        draw() {
            if (this.opacity <= 0) return;
            ctx.save();
            ctx.globalAlpha = Math.max(0, this.opacity);
            ctx.translate(this.x, this.y);
            ctx.rotate(this.rotation);

            switch (this.type) {
                case 0: this.drawHeart(); break;
                case 1: this.drawPaw(); break;
                case 2: this.drawSparkle(); break;
                case 3: this.drawBone(); break;
            }
            ctx.restore();
        }

        drawHeart() {
            ctx.fillStyle = '#ee839d';
            ctx.beginPath();
            const s = this.size / 15;
            ctx.moveTo(0, 0);
            ctx.bezierCurveTo(-5 * s, -5 * s, -10 * s, 2 * s, 0, 10 * s);
            ctx.bezierCurveTo(10 * s, 2 * s, 5 * s, -5 * s, 0, 0);
            ctx.fill();
        }

        drawPaw() {
            ctx.fillStyle = '#f3a683';
            const s = this.size / 16;
            ctx.beginPath();
            ctx.arc(0, 2 * s, 5 * s, 0, Math.PI * 2);
            ctx.fill();
            const toes = [[-5*s, -4*s], [-2*s, -7*s], [2*s, -7*s], [5*s, -4*s]];
            toes.forEach(([tx, ty]) => {
                ctx.beginPath();
                ctx.arc(tx, ty, 2 * s, 0, Math.PI * 2);
                ctx.fill();
            });
        }

        drawSparkle() {
            ctx.fillStyle = '#f7d794';
            const s = this.size / 2;
            ctx.beginPath();
            for (let i = 0; i < 4; i++) {
                ctx.lineTo(Math.cos((i * Math.PI) / 2) * s, Math.sin((i * Math.PI) / 2) * s);
                ctx.lineTo(Math.cos((i * Math.PI) / 2 + Math.PI / 4) * (s / 3), Math.sin((i * Math.PI) / 2 + Math.PI / 4) * (s / 3));
            }
            ctx.closePath();
            ctx.fill();
        }

        drawBone() {
            ctx.fillStyle = '#d1ccc0';
            const s = this.size / 14;
            ctx.fillRect(-6 * s, -1.5 * s, 12 * s, 3 * s);
            ctx.beginPath();
            ctx.arc(-6 * s, -2 * s, 2 * s, 0, Math.PI * 2);
            ctx.arc(-6 * s, 2 * s, 2 * s, 0, Math.PI * 2);
            ctx.arc(6 * s, -2 * s, 2 * s, 0, Math.PI * 2);
            ctx.arc(6 * s, 2 * s, 2 * s, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    let particles = [];
    const MAX_PARTICLES = 15;

    function spawnParticleOnScroll() {
        const currentScrollY = window.scrollY;
        const scrollDelta = Math.abs(currentScrollY - lastScrollY);
        accumulatedScroll += scrollDelta;
        lastScrollY = currentScrollY;

        if (accumulatedScroll >= SCROLL_THRESHOLD) {
            accumulatedScroll = 0;
            if (particles.length < MAX_PARTICLES) {
                particles.push(new Particle(mouseX, mouseY));
            }
        }
    }

    window.addEventListener('scroll', spawnParticleOnScroll, { passive: true });

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = particles.length - 1; i >= 0; i--) {
            particles[i].update();
            particles[i].draw();
            if (particles[i].opacity <= 0) {
                particles.splice(i, 1);
            }
        }
        requestAnimationFrame(animate);
    }

    animate();
})();
</script>
